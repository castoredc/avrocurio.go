{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'schedule:monthly',
    ':semanticCommitsDisabled',
  ],
  automerge: true,
  dependencyDashboard: true,
  labels: [
    'dependencies',
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchCategories: [
        'go',
      ],
      minimumReleaseAge: '7 days',
    },
  ],
  ignorePaths: [],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows//',
      ],
      matchStrings: [
        'version: (?<currentValue>v[\\d.]+) # renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)',
      ],
    },
  ],
}
